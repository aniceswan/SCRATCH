---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import YouTubeSoundtrack from './YouTubeSoundtrack.astro';
import ImageCredit from './ImageCredit.astro';
import { padIndex, type Poem } from '../lib/poems';
import { getClassicEdition } from '../lib/classic-preview';

interface Props {
  poem: Poem;
  number: number;
  total: number;
  previous: {title: string; url: string};
  next: {title: string; url: string};
  series?: {title: string; url: string};
}

const { poem, previous, next, number, total, series } = Astro.props;
const { Content } = await render(poem);
const titleWords = poem.data.title.split(/\s+/);
const {paper: paperEdition} = getClassicEdition(Astro.url.pathname);
---

<Base title={poem.data.title} description={poem.data.excerpt} bodyClass="page-poem">
  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <div class="poem-page" id="top">
    <Header backLink={series ? {url: series.url, label: paperEdition ? 'POEMS' : 'SERIES', ariaLabel: `Kembali ke ${paperEdition ? 'poems' : 'series'} ${series.title}`} : undefined} />

    <main class="poem-layout">
      <aside class="poem__visual">
        <figure class="poem__figure">
          <div class="poem__image">
            <Image
              src={poem.data.image}
              alt={poem.data.imageAlt}
              widths={[460, 640, 900, 1200]}
              sizes="(max-width: 900px) 90vw, 500px"
              loading="eager"
              decoding="async"
            />
          </div>
        </figure>
      </aside>

      <article class="poem__article">
        <div class="poem__text">
          <p class="poem__number" aria-label={`Puisi ${number} dari ${total}`}>{padIndex(number)} / {padIndex(total)}</p>
          <h1 class="poem__title">
            {titleWords.map((word, wordIndex) => (
              <Fragment>
                <span class="word" style={`--i:${wordIndex}`}><span>{word}</span></span>
                {wordIndex < titleWords.length - 1 ? ' ' : ''}
              </Fragment>
            ))}
          </h1>

          {poem.data.youtube && <YouTubeSoundtrack track={poem.data.youtube} placement="control" />}

          <div class="poem__body" lang={poem.data.lang}>
            <Content />
          </div>
        </div>

        <div class="poem__after">
          <div class="poem__end" aria-hidden="true">*</div>

          {poem.data.youtube && <YouTubeSoundtrack track={poem.data.youtube} placement="player" />}

          <ImageCredit credit={poem.data.imageCredit} />

          <nav class="poem-nav" aria-label="Baca puisi lainnya">
            <a class="poem-nav__link" data-poem-nav="previous" href={previous.url}>
              <span class="poem-nav__label">← PUISI SEBELUMNYA</span>
              <span class="poem-nav__title">{previous.title}</span>
            </a>
            <a class="poem-nav__link poem-nav__link--next" data-poem-nav="next" href={next.url}>
              <span class="poem-nav__label">PUISI SELANJUTNYA →</span>
              <span class="poem-nav__title">{next.title}</span>
            </a>
          </nav>
        </div>
      </article>
    </main>

    <p class="copyright">© 2026 scratch</p>
  </div>

  <script>
    const progress = document.querySelector<HTMLElement>('[data-progress]');

    function updateProgress() {
      if (!progress) return;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      progress.style.transform = `scaleX(${value})`;
    }

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
  </script>
</Base>
