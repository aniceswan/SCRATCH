---
import InkLogo from './InkLogo.astro';
import { getClassicEdition } from '../lib/classic-preview';

interface Props {
  home?: boolean;
  backLink?: { url: string; label: string; ariaLabel: string };
}

const { home = false, backLink } = Astro.props;
const {basePath, paper: paperEdition} = getClassicEdition(Astro.url.pathname);
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const paperSeries = paperEdition && (currentPath === `${basePath}/series` || currentPath.startsWith(`${basePath}/series/`));
const paperSeriesIndex = paperSeries && currentPath === `${basePath}/series`;
---

<header class="topbar">
  <a class="brand" href={home ? '#arsip' : `${basePath}/`} aria-label={paperSeries ? 'series | scratch' : 'scratch | archive'}>
    <InkLogo class="brand__ink" />
    {paperSeriesIndex ? <h1 class="brand__name" id="page-title">series</h1> : paperSeries ? <span class="brand__name">series</span> : home && paperEdition && <span class="brand__name">scratch</span>}
  </a>

  <nav class="topbar__actions" aria-label="Navigasi utama">
    {
      home ? (
        <>
          <a class="topbar__link series-entry" href={`${basePath}/series/`} aria-label="Buka series puisi">
            SERIES <span aria-hidden="true">↗</span>
          </a>
          <button class="intro-replay" type="button" data-replay-intro aria-label="Kembali ke pembuka">
            BACK <span aria-hidden="true">←</span>
          </button>
        </>
      ) : (
        <a class="topbar__link" href={backLink?.url ?? `${basePath}/`} aria-label={backLink?.ariaLabel}>
          {backLink?.label ?? 'ARCHIVE'} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </nav>
</header>
