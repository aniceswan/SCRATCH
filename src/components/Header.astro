---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

<header class="topbar">
  <a class="brand" href={home ? '#arsip' : '/'} aria-label="scratch — arsip puisi">
    <svg class="brand__ink" viewBox="0 0 84 26" fill="none" aria-hidden="true" focusable="false">
      <path
        class="brand__ink-line"
        pathLength="1"
        d="M3 15.5C14 3.5 24 21.5 39 13.5C53 6 63 21.5 79 11"
      ></path>
    </svg>
  </a>

  {
    home ? (
      <div class="topbar__actions">
      <button class="sound-toggle" type="button" data-sound-toggle aria-pressed="true" aria-label="Matikan suara perpindahan kartu"><span class="sound-toggle__icon" aria-hidden="true">♪</span> <span data-sound-label>SUARA ON</span></button>
      <button class="intro-replay" type="button" data-replay-intro aria-label="Putar ulang animasi pembuka">
        INTRO <span aria-hidden="true">↺</span>
      </button>
      </div>
    ) : (
      <a class="topbar__link" href="/">
        ARSIP <span aria-hidden="true">↗</span>
      </a>
    )
  }
</header>
