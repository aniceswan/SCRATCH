---
import InkLogo from './InkLogo.astro';
import { getClassicEdition } from '../lib/classic-preview';
import '../styles/navigation.css';

interface Props {
  home?: boolean;
  backLink?: { url: string; label: string; ariaLabel: string };
}

const { home = false, backLink } = Astro.props;
const {basePath, paper: paperEdition} = getClassicEdition(Astro.url.pathname);
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const paperSeries = paperEdition && (currentPath === `${basePath}/series` || currentPath.startsWith(`${basePath}/series/`));
const paperSeriesIndex = paperSeries && currentPath === `${basePath}/series`;
const paperFragments = paperEdition && (currentPath === `${basePath}/fragments` || currentPath.startsWith(`${basePath}/fragments/`));
const paperFragmentsIndex = paperFragments && currentPath === `${basePath}/fragments`;
const paperAbout = paperEdition && currentPath === `${basePath}/about`;
const sectionLabel = paperAbout ? 'about' : paperFragments ? 'fragments' : paperSeries ? 'poems' : null;
---

<header class:list={['topbar', {'topbar--paper': paperEdition}]} data-site-header>
  <a class="brand" href={home ? '#arsip' : `${basePath}/`} aria-label={sectionLabel ? `${sectionLabel} | scratch` : 'scratch | archive'}>
    <InkLogo class="brand__ink" />
    {paperSeriesIndex || paperFragmentsIndex || paperAbout ? <h1 class="brand__name" id="page-title">{sectionLabel}</h1> : sectionLabel ? <span class="brand__name">{sectionLabel}</span> : home && paperEdition && <span class="brand__name">scratch</span>}
  </a>

  {paperEdition && <button class="navigation-toggle" type="button" data-menu-toggle aria-label="Buka menu" aria-expanded="false" aria-controls="site-navigation">
    <span></span><span></span>
  </button>}

  <nav class="topbar__actions" id="site-navigation" aria-label="Navigasi utama" data-site-navigation>
    {paperEdition ? <>
      <a class="topbar__link series-entry" href={`${basePath}/series/`} aria-label="Buka poems" aria-current={paperSeries ? 'true' : undefined}>POEMS <span aria-hidden="true">↗</span></a>
      <a class="topbar__link fragments-entry" href={`${basePath}/fragments/`} aria-label="Buka fragments" aria-current={paperFragments ? 'true' : undefined}>FRAGMENTS <span aria-hidden="true">↗</span></a>
      <a class="topbar__link about-entry" href={`${basePath}/about/`} aria-label="Buka about" aria-current={paperAbout ? 'page' : undefined}>ABOUT <span aria-hidden="true">↗</span></a>
      {home ? <button class="intro-replay" type="button" data-replay-intro aria-label="Kembali ke pembuka">BACK <span aria-hidden="true">←</span></button> : <a class="topbar__link" href={backLink?.url ?? `${basePath}/`} aria-label={backLink?.ariaLabel}>{backLink ? 'BACK' : 'ARCHIVE'} <span aria-hidden="true">↗</span></a>}
    </> : home ? <>
      <a class="topbar__link series-entry" href={`${basePath}/series/`} aria-label="Buka series puisi">SERIES <span aria-hidden="true">↗</span></a>
      <button class="intro-replay" type="button" data-replay-intro aria-label="Kembali ke pembuka">BACK <span aria-hidden="true">←</span></button>
    </> : <>
      <a class="topbar__link" href={backLink?.url ?? `${basePath}/`} aria-label={backLink?.ariaLabel}>{backLink?.label ?? 'ARCHIVE'} <span aria-hidden="true">↗</span></a>
    </>}
  </nav>
</header>

<script>
  import '../scripts/navigation';
</script>

<noscript>
  <style>
    @media (max-width: 640px) {
      .topbar--paper {height: auto; min-height: var(--topbar-h); flex-wrap: wrap; padding-block: 10px;}
      .topbar--paper .navigation-toggle {display: none;}
      .topbar--paper .topbar__actions {position: static; width: 100%; max-height: none; padding: 0; display: flex; flex-wrap: wrap; gap: 16px; visibility: visible; opacity: 1; pointer-events: auto; transform: none; border: 0; background: none; box-shadow: none; backdrop-filter: none;}
      .topbar--paper .topbar__actions > * {width: auto;}
    }
  </style>
</noscript>
