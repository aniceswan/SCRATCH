---
import InkLogo from './InkLogo.astro';

interface Props {
  home?: boolean;
  backLink?: { url: string; label: string; ariaLabel: string };
}

const { home = false, backLink } = Astro.props;
---

<header class="topbar">
  <a class="brand" href={home ? '#arsip' : '/'} aria-label="scratch — arsip puisi">
    <InkLogo class="brand__ink" />
  </a>

  <nav class="topbar__actions" aria-label="Navigasi utama">
    {
      home ? (
        <>
          <a class="series-entry" href="/series/" aria-label="Buka series puisi">
            <svg class="series-entry__chest" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path class="series-entry__lid" d="M5 15V12a7 7 0 0 1 7-7h8a7 7 0 0 1 7 7v3H5Z" />
              <path d="M5 15h22v11H5zM10 16v10m12-10v10" />
              <path class="series-entry__lock" d="M14 13h4v6h-4z" />
              <path class="series-entry__spark" d="M27 1v5m-2.5-2.5h5M2 9v4m-2-2h4" />
            </svg>
            <span>SERIES</span>
            <span class="series-entry__arrow" aria-hidden="true">↗</span>
          </a>
          <button class="intro-replay" type="button" data-replay-intro aria-label="Kembali ke pembuka">
            BACK <span aria-hidden="true">←</span>
          </button>
        </>
      ) : (
        <a class="topbar__link" href={backLink?.url ?? '/'} aria-label={backLink?.ariaLabel}>
          {backLink?.label ?? 'ARCHIVE'} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </nav>
</header>
