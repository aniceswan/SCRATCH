---
import InkLogo from './InkLogo.astro';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

<header class="topbar">
  <a class="brand" href={home ? '#arsip' : '/'} aria-label="scratch — arsip puisi">
    <InkLogo class="brand__ink" />
  </a>

  {
    home ? (
      <button class="intro-replay" type="button" data-replay-intro aria-label="Kembali ke pembuka">
        BACK <span aria-hidden="true">←</span>
      </button>
    ) : (
      <a class="topbar__link" href="/">
        ARCHIVE <span aria-hidden="true">↗</span>
      </a>
    )
  }
</header>
