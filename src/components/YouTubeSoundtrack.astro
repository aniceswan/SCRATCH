---
import SoundtrackControl from './SoundtrackControl.astro';
interface Props {
  track: {videoId: string; title: string; artist: string; startSeconds: number};
  placement: 'control' | 'player';
}
const {track, placement} = Astro.props;
const url = `https://www.youtube.com/watch?v=${track.videoId}&t=${track.startSeconds}s`;
const embed = `https://www.youtube.com/embed/${track.videoId}?enablejsapi=1&playsinline=1&autoplay=0&rel=0&start=${track.startSeconds}`;
---

{placement === 'control' ? <SoundtrackControl title={track.title} artist={track.artist} controls="youtube-soundtrack" /> : (
  <section class="youtube-soundtrack" id="youtube-soundtrack" data-youtube-soundtrack data-video-id={track.videoId} data-track-title={`${track.title} oleh ${track.artist}`} data-start-seconds={track.startSeconds} aria-label={`Lagu pengiring: ${track.title} oleh ${track.artist}`}>
    <div class="youtube-soundtrack__frame">
      <iframe data-youtube-frame src={embed} title={`YouTube: ${track.title} oleh ${track.artist}`} width="560" height="315" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <a class="youtube-soundtrack__external" href={url} target="_blank" rel="noopener noreferrer">Buka di YouTube <span aria-hidden="true">↗</span></a>
  </section>
)}

<script>
  import '../scripts/youtube-soundtrack';
</script>

<style>
  .youtube-soundtrack {max-width: 34rem; margin-top: 36px; scroll-margin-top: 24px;}
  .youtube-soundtrack__frame {position: relative; width: 100%; min-height: 200px; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: #252923;}
  .youtube-soundtrack__frame iframe {position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0;}
  .youtube-soundtrack__external {display: inline-flex; align-items: center; gap: 8px; min-height: 36px; margin-top: 6px; padding-inline: 4px; font-size: 9px; letter-spacing: .04em; color: var(--ink-soft); text-decoration: none;}
  .youtube-soundtrack__external:hover {color: var(--red);}
</style>
