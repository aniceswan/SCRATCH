---
import { getImage } from 'astro:assets';
import type { Poem } from '../lib/poems';
import { padIndex } from '../lib/poems';
import { cardWindow } from '../lib/gallery.js';

interface Props { poems: Poem[]; }
const { poems } = Astro.props;
const catalog = await Promise.all(poems.map(async (poem, index) => {
  const variants = await Promise.all([320, 480, 640, 800].map(width => getImage({src: poem.data.image, width, format: 'webp', quality: 80})));
  return {
    number: padIndex(poem.data.order || index + 1),
    title: poem.data.title, excerpt: poem.data.excerpt,
    url: `/puisi/${poem.id}/`, alt: poem.data.imageAlt,
    src: variants[1].src,
    srcset: variants.map((image, index) => `${image.src} ${[320, 480, 640, 800][index]}w`).join(', '),
  };
}));
const initial = cardWindow(0, catalog.length).sort((a, b) => a.slot - b.slot);
const data = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

<section class="archive" aria-label="Arsip puisi">
  <div class="stage" data-stage tabindex="0" role="region" aria-label="Arsip puisi. Gulir, seret, atau gunakan tombol panah untuk berpindah. Klik gambar di tengah untuk membaca.">
    <div class="stage__track" data-track>
      {initial.map(({slot, index}) => {
        const poem = catalog[index];
        return (
          <div class="slide" data-slide data-slot={slot} data-poem-index={index} style={`--i:${Math.min(index, 6)}`}>
            <a class="poem-card" href={poem.url} data-poem-card data-index={index} aria-label={`Baca puisi ${poem.title}`} draggable="false" tabindex={index === 0 ? 0 : -1}>
                <span class="poem-card__frame">
                  <span class="poem-card__photo">
                    <img src={poem.src} srcset={poem.srcset} sizes="(max-width: 900px) 64vw, 360px" width="480" height="600" alt={poem.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" draggable="false" />
                    <span class="poem-card__shade" aria-hidden="true"></span>
                  </span>
                </span>
            </a>
          </div>
        );
      })}
    </div>
    <nav class="carousel-controls" aria-label="Pilih puisi">
      <button type="button" data-gallery-prev aria-label="Puisi sebelumnya"><span aria-hidden="true">←</span></button>
      <button type="button" data-gallery-next aria-label="Puisi selanjutnya"><span aria-hidden="true">→</span></button>
    </nav>
  </div>
  <script type="application/json" data-poems set:html={data} />
  <noscript>
    <ul class="nojs-list">
      {poems.map((poem, index) => <li><a href={`/puisi/${poem.id}/`}><span>{padIndex(index + 1)}</span>{poem.data.title}</a></li>)}
    </ul>
  </noscript>
</section>
