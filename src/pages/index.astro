---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import Archive from '../components/Archive.astro';
import { getPoems } from '../lib/poems';

const poems = await getPoems();
const featured = poems[0];
const titleWords = featured?.data.title.split(/\s+/) ?? [];
---

<Base bodyClass="page-home" description="scratch — arsip puisi pribadi. Kumpulan puisi dan gambar, disimpan pelan-pelan.">
  <Intro />

  <div class="site-shell" data-site-shell>
    <Header home />

    <main class="home" id="arsip" tabindex="-1">
      {
        featured ? (
          <>
            <section class="feature" aria-labelledby="feature-title" data-feature>
              <div class="feature__main">
                <h1 class="feature__title" id="feature-title" data-feature-title>
                  {titleWords.map((word, index) => (
                    <Fragment>
                      <span class="word" style={`--i:${index}`}><span>{word}</span></span>
                      {index < titleWords.length - 1 ? ' ' : ''}
                    </Fragment>
                  ))}
                </h1>
                <p class="feature__excerpt" data-feature-excerpt>{featured.data.excerpt}</p>
              </div>
            </section>

            <Archive poems={poems} />
          </>
        ) : (
          <section class="empty">
            <p class="eyebrow">ARSIP KOSONG</p>
            <h1>Belum ada puisi.</h1>
            <p>Tambahkan file pertama di <code>src/content/puisi/</code>.</p>
          </section>
        )
      }
    </main>

    <Footer />
  </div>

  <script>
    const stage = document.querySelector<HTMLElement>('[data-stage]');
    const shell = document.querySelector<HTMLElement>('[data-site-shell]');
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    const main = document.querySelector<HTMLElement>('#arsip');
    const enterLink = document.querySelector<HTMLAnchorElement>('[data-enter]');
    const replayButton = document.querySelector<HTMLButtonElement>('[data-replay-intro]');

    const hangs = Array.from(document.querySelectorAll<HTMLElement>('[data-hang]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-poem-card]'));
    const featureTitle = document.querySelector<HTMLElement>('[data-feature-title]');
    const featureExcerpt = document.querySelector<HTMLElement>('[data-feature-excerpt]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

    let pos = 0;
    let target = 0;
    let current = -1;
    let raf = 0;
    let running = false;
    let snapTimer = 0;
    let dragging = false;
    let pointerStartX = 0;
    let pointerStartTarget = 0;
    let pointerMoved = 0;
    let suppressClick = false;
    let leaving = false;
    let pageScrolls = false;

    function setWords(element: HTMLElement, text: string) {
      element.replaceChildren();
      const words = text.split(/\s+/).filter(Boolean);

      words.forEach((word, index) => {
        const outer = document.createElement('span');
        outer.className = 'word';
        outer.style.setProperty('--i', String(index));
        const inner = document.createElement('span');
        inner.textContent = word;
        outer.append(inner);
        element.append(outer);
        if (index < words.length - 1) element.append(document.createTextNode(' '));
      });
    }

    function updateFeature(index: number) {
      if (index === current) return;
      current = index;

      hangs.forEach((hang, i) => {
        hang.classList.toggle('is-active', i === index);
      });
      cards.forEach((card, i) => {
        const active = i === index;
        card.classList.toggle('is-active', active);
        card.tabIndex = active ? 0 : -1;
        if (active) card.setAttribute('aria-current', 'true');
        else card.removeAttribute('aria-current');
      });

      const card = cards[index];
      if (!card) return;

      if (featureTitle) {
        setWords(featureTitle, card.dataset.title ?? '');
        featureTitle.setAttribute('aria-label', card.dataset.title ?? '');
      }
      if (featureExcerpt) {
        featureExcerpt.textContent = card.dataset.excerpt ?? '';
        if (!reduceMotion) {
          featureExcerpt.animate(
            [
              { opacity: 0, transform: 'translateY(10px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 520, easing: 'cubic-bezier(.22,.75,.25,1)' },
          );
        }
      }
    }

    function render() {
      if (!stage || hangs.length === 0) return;

      const n = hangs.length;
      const width = stage.clientWidth;
      const height = stage.clientHeight;
      const cardWidth = hangs[0].offsetWidth || 360;
      const cardHeight = hangs[0].offsetHeight || 460;
      const baseX = width / 2 - cardWidth / 2;
      const baseY = height / 2 - cardHeight / 2;

      const wrap = (value: number) => {
        let distance = value % n;
        if (distance < 0) distance += n;
        if (distance > n / 2) distance -= n;
        return distance;
      };

      hangs.forEach((hang, index) => {
        const distance = wrap(index - pos);
        const behind = distance >= 0;
        const depth = Math.abs(distance);
        const x = baseX + (behind ? distance * cardWidth * 0.16 : distance * cardWidth * 0.18);
        const y = baseY + (behind ? -distance * 22 : -distance * 30);
        const z = behind ? -distance * 175 : -distance * 460;
        const rotateY = behind ? clamp(distance * 4.4, -14, 14) : clamp(-distance * 7, -18, 18);
        const opacity = behind
          ? distance > 3.45
            ? 0
            : clamp(1 - distance * 0.075, 0, 1)
          : clamp(1 + distance * 1.2, 0, 1);

        hang.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, ${z.toFixed(2)}px) rotateY(${rotateY.toFixed(2)}deg)`;
        hang.style.opacity = String(opacity);
        hang.style.zIndex = String(
          distance < 0 ? 1300 + Math.round(depth * 10) : 1200 - Math.round(distance * 10),
        );
        hang.style.pointerEvents = Math.abs(distance) < 0.45 ? '' : 'none';
      });

      const active = ((Math.round(pos) % n) + n) % n;
      updateFeature(active);
    }

    function tick() {
      const ease = reduceMotion ? 1 : 0.14;
      const difference = target - pos;

      if (Math.abs(difference) < 0.001) {
        pos = target;
        render();
        running = false;
        return;
      }

      pos += difference * ease;
      render();
      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(tick);
    }

    function snap(delay = 260) {
      window.clearTimeout(snapTimer);
      snapTimer = window.setTimeout(() => {
        target = Math.round(target);
        start();
      }, delay);
    }

    function markReady() {
      stage?.classList.add('is-ready');
      start();
    }

    function replayFeature() {
      const card = cards[current];
      if (!featureTitle || !card) return;
      setWords(featureTitle, card.dataset.title ?? '');
      featureTitle.setAttribute('aria-label', card.dataset.title ?? '');
    }

    function completeEntry(focus = true) {
      if (!intro) return;
      intro.classList.add('is-hidden');
      intro.setAttribute('aria-hidden', 'true');
      root.classList.add('has-entered');
      root.classList.remove('intro-skip');
      shell?.removeAttribute('inert');
      try {
        sessionStorage.setItem('scratch:entered', '1');
      } catch {
        /* no-op */
      }
      markReady();
      if (focus) main?.focus({ preventScroll: true });
    }

    function enter(event?: Event) {
      event?.preventDefault();
      if (leaving) return;
      leaving = true;

      root.classList.add('is-entering');
      intro?.classList.add('is-leaving');
      shell?.removeAttribute('inert');
      window.setTimeout(markReady, reduceMotion ? 0 : 260);
      window.setTimeout(replayFeature, reduceMotion ? 0 : 380);

      window.setTimeout(
        () => {
          completeEntry();
          try {
            history.replaceState(null, '', `${location.pathname}#arsip`);
          } catch {
            /* no-op */
          }
          leaving = false;
        },
        reduceMotion ? 30 : 1350,
      );
    }

    function showIntro() {
      if (!intro) return;
      try {
        sessionStorage.removeItem('scratch:entered');
      } catch {
        /* no-op */
      }
      try {
        history.replaceState(null, '', location.pathname + location.search);
      } catch {
        /* no-op */
      }
      leaving = false;
      root.classList.remove('has-entered', 'intro-skip', 'is-entering');
      intro.classList.remove('is-hidden', 'is-leaving');
      intro.removeAttribute('aria-hidden');
      shell?.setAttribute('inert', '');
      window.scrollTo(0, 0);
      window.setTimeout(() => enterLink?.focus({ preventScroll: true }), 50);
    }

    // --- Intro -------------------------------------------------------------
    if (root.classList.contains('intro-skip')) {
      completeEntry(false);
    } else {
      shell?.setAttribute('inert', '');
      enterLink?.addEventListener('click', enter);
    }

    replayButton?.addEventListener('click', showIntro);

    // --- Arsip 3D ----------------------------------------------------------
    if (stage && cards.length > 0) {
      const updateScrollState = () => {
        pageScrolls = document.documentElement.scrollHeight > window.innerHeight + 4;
      };

      updateScrollState();
      render();

      stage.addEventListener(
        'wheel',
        (event) => {
          if (event.ctrlKey) return;
          // Kalau halaman memang bisa digulir, jangan rebut wheel dari scroll.
          if (pageScrolls) return;
          event.preventDefault();
          const delta = Math.abs(event.deltaX) > Math.abs(event.deltaY) ? event.deltaX : event.deltaY;
          target += delta * 0.0032;
          start();
          snap(320);
        },
        { passive: false },
      );

      stage.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        pointerStartX = event.clientX;
        pointerStartTarget = target;
        pointerMoved = 0;
        stage.classList.add('is-grabbing');
      });

      window.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - pointerStartX;
        pointerMoved = Math.max(pointerMoved, Math.abs(dx));
        if (pointerMoved < 4) return;

        const cardWidth = hangs[0]?.offsetWidth || 360;
        target = pointerStartTarget - dx / (cardWidth * 0.86);
        start();
      });

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        stage.classList.remove('is-grabbing');

        if (pointerMoved > 7) {
          suppressClick = true;
          target = Math.round(target);
          start();
          window.setTimeout(() => {
            suppressClick = false;
          }, 80);
        }
      };

      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);

      stage.addEventListener(
        'click',
        (event) => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
        },
        true,
      );

      const handleArrowKey = (event: KeyboardEvent) => {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        const el = event.target;
        if (el instanceof HTMLElement && el.closest('input, textarea, select, [contenteditable="true"]')) return;
        if (intro && !root.classList.contains('has-entered')) return;

        const direction = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (direction === 0) return;
        event.preventDefault();
        target = Math.round(target) + direction;
        start();
      };

      window.addEventListener('keydown', handleArrowKey);

      const resizeObserver = new ResizeObserver(() => {
        updateScrollState();
        render();
        start();
      });
      resizeObserver.observe(stage);

      window.addEventListener('resize', () => {
        updateScrollState();
        render();
      });
    }
  </script>
</Base>
