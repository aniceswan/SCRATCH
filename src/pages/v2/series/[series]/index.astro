---
import {Image} from 'astro:assets';
import Edition from '../../../../layouts/Edition.astro';
import PoemCard from '../../../../components/edition/PoemCard.astro';
import {getSeries, type PoetrySeries} from '../../../../lib/series';
import {padIndex} from '../../../../lib/poems';
export async function getStaticPaths() {return (await getSeries()).map((entry, index) => ({params: {series: entry.id}, props: {entry, index}}));}
interface Props {entry: PoetrySeries; index: number;}
const {entry, index} = Astro.props;
---
<Edition title={entry.data.title} current="series">
  <main class="edition-catalog" id="main">
    <a class="back-link eyebrow" href="/v2/series/">← ALL SERIES</a>
    <header class="collection-heading"><div class="collection-heading__cover"><Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[360, 640]} sizes="(max-width: 600px) 28vw, 180px" loading="eager" /></div><div><p class="eyebrow">VOL. {padIndex(index + 1)} / {padIndex(entry.poems.length)} POEMS</p><h1>{entry.data.title}<span>*</span></h1></div></header>
    <div class="edition-poem-grid">{entry.poems.map((poem, poemIndex) => <PoemCard poem={poem} number={poemIndex + 1} href={`/v2/series/${entry.id}/puisi/${poem.id}/`} eager={poemIndex < 3} />)}</div>
  </main>
</Edition>
